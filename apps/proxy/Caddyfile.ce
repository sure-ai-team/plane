(sgtpm_proxy) {
	# Browsers upload straight to MinIO with presigned POSTs, whose policy
	# already enforces each file's size (chat videos can be 200 MB), so the
	# storage bucket gets its own cap. Everything else keeps FILE_SIZE_LIMIT.
	@storage path /{$BUCKET_NAME} /{$BUCKET_NAME}/*
	request_body @storage {
		max_size {$UPLOAD_SIZE_LIMIT:2147483648}
	}
	@notStorage not path /{$BUCKET_NAME} /{$BUCKET_NAME}/*
	request_body @notStorage {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /superadmin /superadmin/ permanent
	reverse_proxy /superadmin/* admin:3000

	# The console moved from /god-mode; keep old links and bookmarks working.
	@oldAdmin path_regexp oldAdmin ^/god-mode(/.*)?$
	redir @oldAdmin /superadmin{re.oldAdmin.1} permanent
	
	reverse_proxy /live/* live:3000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* minio:9000
	reverse_proxy /{$BUCKET_NAME} minio:9000

	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import sgtpm_proxy
}